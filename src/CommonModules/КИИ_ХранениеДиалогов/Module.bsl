#Область ПрограммныйИнтерфейс

// Создает отдельную беседу текущего пользователя.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Эксперт - СправочникСсылка.КИИ_ЭкспертыИИ - эксперт; допускается пустая ссылка.
//  Настройки - Структура, Неопределено - настройки контекста и выбранной модели беседы.
// 
// Возвращаемое значение:
//  Строка - идентификатор новой беседы.
// 
Функция СоздатьДиалог(Знач Эксперт, Знач Настройки = Неопределено) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = СоздатьДиалогВХранилище(Эксперт, Настройки);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Возвращает заголовок, черновик, настройки и версию своей беседы.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
// 
// Возвращаемое значение:
//  Структура - состояние собственной беседы; чужой идентификатор вызывает исключение.
// 
Функция Диалог(Знач Идентификатор) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ДиалогВХранилище(Идентификатор);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Возвращает только беседы текущего пользователя от новых изменений к старым.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - идентификатор, заголовок, эксперт, модель, дата изменения и состояние.
// 
Функция МоиДиалоги() Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = МоиДиалогиВХранилище();
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Сохраняет черновик своей беседы при совпадении версии.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  Черновик - Строка - еще не отправленный текст вопроса.
//  Эксперт - СправочникСсылка.КИИ_ЭкспертыИИ - эксперт; допускается пустая ссылка.
//  Настройки - Структура - настройки контекста и выбранной модели беседы.
//  Версия - Число - версия беседы, с которой пользователь начал изменение.
// 
// Возвращаемое значение:
//  Число - версия после сохранения; неизменный черновик не повышает версию.
// 
Функция СохранитьЧерновик(Знач Идентификатор, Знач Черновик, Знач Эксперт, Знач Настройки, Знач Версия) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = СохранитьЧерновикВХранилище(Идентификатор, Черновик, Эксперт, Настройки, Версия);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Меняет заголовок своей беседы, сохраняя историю и материалы.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  Заголовок - Строка - пользовательское название беседы.
// 
Процедура ПереименоватьДиалог(Знач Идентификатор, Знач Заголовок) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ПереименоватьДиалогВХранилище(Идентификатор, Заголовок);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
