КонецПроцедуры

// Удаляет свою беседу вместе с сообщениями, вложениями и сохраненными запросами.
// Выполняющийся запрос или использование материалов другой беседой запрещают удаление.
//
// Параметры:
//  Идентификатор - Строка - идентификатор собственной беседы.
//  Версия - Число - версия, показанная пользователю перед подтверждением.
//
Процедура УдалитьДиалог(Знач Идентификатор, Знач Версия) Экспорт

	Беседа = Новый Структура("Диалог,Версия", Идентификатор, Версия);
	Беседы = Новый Массив;
	Беседы.Добавить(Беседа);
	УдалитьДиалоги(Беседы);

КонецПроцедуры

// Удаляет подтвержденный набор собственных бесед в одной транзакции.
// Сначала блокирует и проверяет весь набор, затем удаляет данные.
// При внешней транзакции ее завершение и откат остаются обязанностью вызывающего кода.
//
// Параметры:
//  Беседы - Массив из Структура - снимок подтвержденного выделения:
//   * Диалог - Строка - идентификатор собственной беседы.
//   * Версия - Число - версия, показанная перед подтверждением.
//
Процедура УдалитьДиалоги(Знач Беседы) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		УдалитьДиалогиВХранилище(Беседы);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);

КонецПроцедуры

// Проверяет существование своей беседы без раскрытия чужих данных.
//
// Параметры:
//  Идентификатор - Строка - идентификатор проверяемой беседы.
//
// Возвращаемое значение:
//  Булево - беседа существует и принадлежит текущему пользователю.
//
Функция ДиалогДоступен(Знач Идентификатор) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗаписьДиалога = РегистрыСведений.КИИ_ДиалогиЧата.СоздатьМенеджерЗаписи();
		ЗаписьДиалога.Диалог = Идентификатор;
		ЗаписьДиалога.Прочитать();
		Владелец = ТекущийВладелец();
		Результат = ЗаписьДиалога.Выбран() И ЗаписьДиалога.Владелец = Владелец;
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Читает сообщения своей беседы в порядке их стабильных номеров.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  ПослеНомера - Число - номер последнего уже прочитанного сообщения; ноль означает начало.
//  РазмерПорции - Число - максимум сообщений; ноль означает всю оставшуюся историю.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - сообщения после указанного курсора.
// 
Функция СообщенияДиалога(Знач Идентификатор, Знач ПослеНомера = 0, Знач РазмерПорции = 100) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = СообщенияДиалогаВХранилище(Идентификатор, ПослеНомера, РазмерПорции);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

