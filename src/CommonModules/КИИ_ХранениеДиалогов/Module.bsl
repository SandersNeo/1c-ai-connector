КонецФункции

// Однократно переводит принятый запрос своей беседы в выполнение и возвращает его снимок.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  ЗапросЧата - Строка - идентификатор запроса в указанной беседе.
// 
// Возвращаемое значение:
//  Структура - неизменные данные запроса для исполнителя.
// 
Функция ПакетДляВыполнения(Знач Идентификатор, Знач ЗапросЧата) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ПакетДляВыполненияВХранилище(Идентификатор, ЗапросЧата);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Возвращает сохраненный статус запроса своей беседы без повторного обращения к модели.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  ЗапросЧата - Строка - идентификатор запроса в указанной беседе.
// 
// Возвращаемое значение:
//  Структура - состояние, результат либо ошибка запроса.
// 
Функция СостояниеЗапроса(Знач Идентификатор, Знач ЗапросЧата) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = СостояниеЗапросаВХранилище(Идентификатор, ЗапросЧата);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Идемпотентно сохраняет результат или ошибку своего запроса вместе с сообщением и файлами.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  ЗапросЧата - Строка - идентификатор запроса в указанной беседе.
//  Итог - Структура, Неопределено - результат исполнителя с ответом модели; отсутствие означает ошибку.
//  ТекстОшибки - Строка - описание ошибки исполнителя при отсутствии результата.
// 
Процедура СохранитьИтогЗапроса(Знач Идентификатор, Знач ЗапросЧата, Знач Итог, Знач ТекстОшибки) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		СохранитьИтогЗапросаВХранилище(Идентификатор, ЗапросЧата, Итог, ТекстОшибки);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);

КонецПроцедуры

// Сохраняет привязку фонового задания либо неопределенный исход запуска своего запроса.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  ЗапросЧата - Строка - идентификатор запроса в указанной беседе.
//  Задание - Строка - идентификатор фонового задания; пустая строка означает отсутствие привязки.
//  Неопределенность - Строка - диагностика неопределенного запуска; пустая строка означает отсутствие ошибки.
// 
Процедура ЗаписатьСостояниеЗапуска(Знач Идентификатор, Знач ЗапросЧата, Знач Задание, Знач Неопределенность) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗаписатьСостояниеЗапускаВХранилище(Идентификатор, ЗапросЧата, Задание, Неопределенность);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);

КонецПроцедуры

// Сверяет сохраненный статус своего запроса с состоянием его фонового задания.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  ЗапросЧата - Строка - идентификатор запроса в указанной беседе.
// 
// Возвращаемое значение:
//  Структура - сохраненный статус с диагностикой неизвестного результата; повтор не отправляется.
// 
Функция СостояниеЗапросаСЗаданием(Знач Идентификатор, Знач ЗапросЧата) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = СостояниеЗапросаСЗаданиемВХранилище(Идентификатор, ЗапросЧата);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Обновляет текстовый снимок источника только в собственном черновике.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  Материал - Строка - идентификатор материала указанной беседы.
// 
// Возвращаемое значение:
//  Строка - идентификатор обновленного материала.
// 
Функция ОбновитьИсточник(Знач Идентификатор, Знач Материал) Экспорт

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ОбновитьИсточникВХранилище(Идентификатор, Материал);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Результат;

КонецФункции

// Выполняет принятый запрос собственной беседы и сохраняет итог без зависимости от открытой формы.
// Владелец определяется текущим сеансом; чужие беседы недоступны.
// 
// Параметры:
//  Идентификатор - Строка - идентификатор беседы текущего пользователя.
//  ЗапросЧата - Строка - идентификатор запроса в указанной беседе.
// 
// Возвращаемое значение:
//  Структура - состояние завершенного запроса.
// 
Функция ВыполнитьЗапрос(Знач Идентификатор, Знач ЗапросЧата) Экспорт

	Пакет = ПакетДляВыполнения(Идентификатор, ЗапросЧата);
	Попытка
		Пакет.Параметры.АдресПодготовки = ПоместитьВоВременноеХранилище(Неопределено);
		// Сетевой исполнитель работает с правами пользователя фонового задания.
		// Привилегия включается и снимается только внутри методов хранилища.
		Если ПривилегированныйРежим() Тогда
			ВызватьИсключение НСтр("ru = 'Отправка запроса должна выполняться без привилегированного режима.'");
		КонецЕсли;
		Итог = КИИ_КонтекстДиалога.ВыполнитьОперацию(Пакет.Данные, Пакет.Параметры, "Отправка");
		СохранитьИтогЗапроса(Идентификатор, ЗапросЧата, Итог, "");
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
		СохранитьИтогЗапроса(Идентификатор, ЗапросЧата, Неопределено, ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Все публичные операции получают владельца из сеанса, а не из аргументов клиента.
Функция СоздатьДиалогВХранилище(Знач Эксперт, Знач Настройки = Неопределено)

	Идентификатор = НовыйИдентификатор();
	ЗаписьДиалога = РегистрыСведений.КИИ_ДиалогиЧата.СоздатьМенеджерЗаписи();
	ЗаписьДиалога.Диалог = Идентификатор;
	ЗаписьДиалога.Владелец = ТекущийВладелец();
	ЗаписьДиалога.Заголовок = НСтр("ru = 'Новый диалог'");
	ЗаписьДиалога.Эксперт = Эксперт;
	Если ЗначениеЗаполнено(Эксперт) Тогда
		ЗаписьДиалога.Модель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "Модель");
	КонецЕсли;
	Если Настройки = Неопределено Тогда
		Настройки = Новый Структура;
	КонецЕсли;
	ЗаписьДиалога.Настройки = Новый ХранилищеЗначения(Настройки);
	ЗаписьДиалога.Версия = 1;
	ЗаписьДиалога.Состояние = "Готов";
	ЗаписьДиалога.Создан = ТекущаяУниверсальнаяДата();
	ЗаписьДиалога.Изменен = ЗаписьДиалога.Создан;
	ЗаписьДиалога.Записать();
	Возврат Идентификатор;

КонецФункции

Функция ДиалогВХранилище(Знач Идентификатор)

	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	Результат = Новый Структура;
	Результат.Вставить("Диалог", ЗаписьДиалога.Диалог);
	Заголовок = НормализованныйЗаголовокДиалога(ЗаписьДиалога.Заголовок);
	Результат.Вставить("Заголовок", Заголовок);
	Результат.Вставить("Эксперт", ЗаписьДиалога.Эксперт);
	Результат.Вставить("Модель", ЗаписьДиалога.Модель);
	Результат.Вставить("Черновик", ЗаписьДиалога.Черновик);
	Настройки = ЗаписьДиалога.Настройки.Получить();
	Результат.Вставить("Настройки", Настройки);
	Результат.Вставить("Версия", ЗаписьДиалога.Версия);
	Результат.Вставить("НомерСообщения", ЗаписьДиалога.НомерСообщения);
	Результат.Вставить("АктивныйЗапрос", ЗаписьДиалога.АктивныйЗапрос);
	Результат.Вставить("Состояние", ЗаписьДиалога.Состояние);
	Возврат Результат;

КонецФункции

Функция МоиДиалогиВХранилище()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДиалогиЧата.Диалог КАК Диалог,
		|	ДиалогиЧата.Заголовок КАК Заголовок,
		|	ДиалогиЧата.Эксперт КАК Эксперт,
		|	ДиалогиЧата.Модель КАК Модель,
		|	ДиалогиЧата.Изменен КАК Изменен,
		|	ДиалогиЧата.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.КИИ_ДиалогиЧата КАК ДиалогиЧата
		|ГДЕ
		|	ДиалогиЧата.Владелец = &Владелец
		|УПОРЯДОЧИТЬ ПО
		|	ДиалогиЧата.Изменен УБЫВ, ДиалогиЧата.Диалог";
	Владелец = ТекущийВладелец();
	Запрос.УстановитьПараметр("Владелец", Владелец);
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выгрузить();
	Для Каждого Диалог Из Результат Цикл
		Диалог.Заголовок = НормализованныйЗаголовокДиалога(Диалог.Заголовок);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СохранитьЧерновикВХранилище(Знач Идентификатор, Знач Черновик, Знач Эксперт, Знач Настройки, Знач Версия)

	Перем МодельДиалога;
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаписьДиалога = ЗаблокироватьСвойДиалог(Идентификатор);
		Если ЗаписьДиалога.Версия <> Версия Тогда
			ВызватьИсключение НСтр("ru = 'Беседа изменена в другом окне. Обновите ее перед сохранением.'");
		КонецЕсли;
		ТекущиеНастройки = ЗаписьДиалога.Настройки.Получить();
		ТекущиеНастройкиТекст = ЗначениеВСтрокуВнутр(ТекущиеНастройки);
		НовыеНастройкиТекст = ЗначениеВСтрокуВнутр(Настройки);
		ЧерновикНеИзменен = ЗаписьДиалога.Черновик = Черновик
			И ЗаписьДиалога.Эксперт = Эксперт
			И ТекущиеНастройкиТекст = НовыеНастройкиТекст;
		Если Не ЧерновикНеИзменен Тогда
			ЗаписьДиалога.Черновик = Черновик;
			ЗаписьДиалога.Эксперт = Эксперт;
			Если Настройки.Свойство("Модель", МодельДиалога) Тогда
				ЗаписьДиалога.Модель = МодельДиалога;
			Иначе
				Если ЗначениеЗаполнено(Эксперт) Тогда
					ЗаписьДиалога.Модель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "Модель");
				КонецЕсли;
			КонецЕсли;
			ЗаписьДиалога.Настройки = Новый ХранилищеЗначения(Настройки);
			ЗаписьДиалога.Версия = ЗаписьДиалога.Версия + 1;
			ЗаписьДиалога.Изменен = ТекущаяУниверсальнаяДата();
			ЗаписьДиалога.Записать();
		КонецЕсли;
		Результат = ЗаписьДиалога.Версия;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура ПереименоватьДиалогВХранилище(Знач Идентификатор, Знач Заголовок)

	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаписьДиалога = ЗаблокироватьСвойДиалог(Идентификатор);
		ЗаписьДиалога.Заголовок = НормализованныйЗаголовокДиалога(Заголовок);
		ЗаписьДиалога.Изменен = ТекущаяУниверсальнаяДата();
		ЗаписьДиалога.Записать();
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура УдалитьДиалогиВХранилище(Знач Беседы)

	Если Беседы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаписиДиалогов = ЗаблокироватьДиалогиДляУдаления(Беседы);
		ИменаРегистров = СтрРазделить("КИИ_МатериалыЧата,КИИ_СообщенияЧата,КИИ_ЗапросыЧата", ",");
		Для Каждого ЗаписьДиалога Из ЗаписиДиалогов Цикл
			Для Каждого ИмяРегистра Из ИменаРегистров Цикл
				НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Диалог.Установить(ЗаписьДиалога.Диалог);
				НаборЗаписей.Записать();
			КонецЦикла;
			ЗаписьДиалога.Удалить();
		КонецЦикла;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Блокирует и проверяет весь подтвержденный набор до первого удаления.
Функция ЗаблокироватьДиалогиДляУдаления(Знач Беседы)

	ЗаписиДиалогов = Новый Массив;
	ПроверенныеДиалоги = Новый Соответствие;
	Для Каждого Беседа Из Беседы Цикл
		Если ПроверенныеДиалоги.Получить(Беседа.Диалог) <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Один диалог указан для удаления несколько раз.'");
		КонецЕсли;
		ЗаписьДиалога = ЗаблокироватьСвойДиалог(Беседа.Диалог);
		Если ЗаписьДиалога.Версия <> Беседа.Версия Тогда
			ВызватьИсключение НСтр("ru = 'Беседа изменилась. Обновите список и подтвердите удаление еще раз.'");
		КонецЕсли;
		Если Не ПустаяСтрока(ЗаписьДиалога.АктивныйЗапрос) Тогда
			ВызватьИсключение НСтр(
				"ru = 'В беседе есть незавершенный запрос. Дождитесь его завершения перед удалением.'");
		КонецЕсли;
		ПроверитьИспользованиеДиалога(Беседа.Диалог);
		ПроверенныеДиалоги.Вставить(Беседа.Диалог, Истина);
		ЗаписиДиалогов.Добавить(ЗаписьДиалога);
	КонецЦикла;
	Возврат ЗаписиДиалогов;

КонецФункции

// Добавление источника блокирует обе беседы, поэтому новая связь не появится во время удаления.
Процедура ПроверитьИспользованиеДиалога(Знач Идентификатор)

	// Достаточно одной связи, чтобы запретить удаление источника контекста или файла.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	МатериалыЧата.Диалог КАК Диалог
		|ИЗ
		|	РегистрСведений.КИИ_МатериалыЧата КАК МатериалыЧата
		|ГДЕ
		|	МатериалыЧата.ИсходныйДиалог = &Диалог
		|	И МатериалыЧата.Диалог <> &Диалог";
	Запрос.УстановитьПараметр("Диалог", Идентификатор);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение НСтр(
			"ru = 'Материалы используются в другой беседе. Удаление запрещено для сохранности ее контекста и файлов.'");
	КонецЕсли;

КонецПроцедуры

// Номер - стабильный курсор. Ноль размера порции означает всю историю для подготовки контекста.
Функция СообщенияДиалогаВХранилище(Знач Идентификатор, Знач ПослеНомера = 0, Знач РазмерПорции = 100)

	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	ВерхняяГраница = ЗаписьДиалога.НомерСообщения;
	Если РазмерПорции > 0 Тогда
		ВерхняяГраница = Мин(ВерхняяГраница, ПослеНомера + РазмерПорции);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СообщенияЧата.Сообщение КАК Сообщение,
		|	СообщенияЧата.Номер КАК Номер,
		|	СообщенияЧата.Роль КАК Роль,
		|	СообщенияЧата.Текст КАК Текст,
		|	СообщенияЧата.Сведения КАК Сведения,
		|	СообщенияЧата.Создано КАК Создано,
		|	СообщенияЧата.ЗапросЧата КАК ЗапросЧата
		|ИЗ
		|	РегистрСведений.КИИ_СообщенияЧата КАК СообщенияЧата
		|ГДЕ
		|	СообщенияЧата.Диалог = &Диалог
		|	И СообщенияЧата.Владелец = &Владелец
		|	И СообщенияЧата.Номер > &ПослеНомера
		|	И СообщенияЧата.Номер <= &ВерхняяГраница
		|УПОРЯДОЧИТЬ ПО
		|	СообщенияЧата.Номер";
	Запрос.УстановитьПараметр("Диалог", Идентификатор);
	Запрос.УстановитьПараметр("Владелец", ЗаписьДиалога.Владелец);
	Запрос.УстановитьПараметр("ПослеНомера", ПослеНомера);
	Запрос.УстановитьПараметр("ВерхняяГраница", ВерхняяГраница);
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выгрузить();
	Возврат Результат;

КонецФункции

Функция МатериалыДиалогаВХранилище(Знач Идентификатор)

	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МатериалыЧата.Материал КАК Материал,
		|	МатериалыЧата.Сообщение КАК Сообщение,
		|	МатериалыЧата.Вид КАК Вид,
		|	МатериалыЧата.Имя КАК Имя,
		|	МатериалыЧата.MIME КАК MIME,
		|	МатериалыЧата.РазмерБайт КАК РазмерБайт,
		|	МатериалыЧата.Отправлять КАК Отправлять,
		|	МатериалыЧата.ИсходныйДиалог КАК ИсходныйДиалог,
		|	МатериалыЧата.ИсходноеСообщение КАК ИсходноеСообщение,
		|	МатериалыЧата.ИсходныйМатериал КАК ИсходныйМатериал
		|ИЗ
		|	РегистрСведений.КИИ_МатериалыЧата КАК МатериалыЧата
		|ГДЕ
		|	МатериалыЧата.Диалог = &Диалог
		|	И МатериалыЧата.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Диалог", Идентификатор);
	Запрос.УстановитьПараметр("Владелец", ЗаписьДиалога.Владелец);
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выгрузить();
	Возврат Результат;

КонецФункции

Функция ДобавитьФайлВХранилище(Знач Идентификатор, Знач ОписаниеФайла, Знач ДвоичныеДанные)

	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение НСтр("ru = 'Содержимое файла недоступно. Прикрепите файл повторно.'");
	КонецЕсли;
	ЗаписьМатериала = НовыйМатериал(ЗаписьДиалога);
	ЗаписьМатериала.Вид = "Файл";
	ЗаписьМатериала.Имя = ОписаниеФайла.Имя;
	ЗаписьМатериала.MIME = ОписаниеФайла.MIME;
	ЗаписьМатериала.РазмерБайт = ДвоичныеДанные.Размер();
	ЗаписьМатериала.Содержимое = Новый ХранилищеЗначения(ДвоичныеДанные);
	ЗаписьМатериала.Записать();
	Результат = ЗаписьМатериала.Материал;
	Возврат Результат;

КонецФункции

Функция СодержимоеМатериалаВХранилище(Знач Идентификатор, Знач Материал)

	ПрочитатьСвойДиалог(Идентификатор);
	ЗаписьМатериала = ПрочитатьСвойМатериал(Идентификатор, Материал);
	Если Не ПустаяСтрока(ЗаписьМатериала.ИсходныйМатериал) Тогда
		ИсходныйДиалог = ПрочитатьСвойДиалог(ЗаписьМатериала.ИсходныйДиалог);
		ЗаписьМатериала = ПрочитатьСвойМатериал(ИсходныйДиалог.Диалог, ЗаписьМатериала.ИсходныйМатериал);
	КонецЕсли;
	Результат = ЗаписьМатериала.Содержимое.Получить();
	Возврат Результат;

КонецФункции

Процедура ОтметитьМатериалВХранилище(Знач Идентификатор, Знач Материал, Знач Отправлять)

	ЗаписьМатериала = ПрочитатьСвойМатериал(Идентификатор, Материал);
	Если ЗначениеЗаполнено(ЗаписьМатериала.Сообщение) Тогда
		ВызватьИсключение НСтр("ru = 'Вложение отправленного сообщения неизменно. Добавьте его в новый вопрос.'");
	КонецЕсли;
	ЗаписьМатериала.Отправлять = Отправлять;
	ЗаписьМатериала.Записать();

КонецПроцедуры

// Источник - структура с Диалог и одним из Сообщение / Материал.
Функция ДобавитьИсточникВХранилище(Знач Идентификатор, Знач Источник)

	Перем ИдентификаторСообщения;
	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	ИсходныйДиалог = ПрочитатьСвойДиалог(Источник.Диалог);
	ЗаписьМатериала = НовыйМатериал(ЗаписьДиалога);
	ЗаписьМатериала.ИсходныйДиалог = Источник.Диалог;
	ТекстСнимка = "";
	Если Источник.Свойство("Сообщение", ИдентификаторСообщения) Тогда
		ТекстСнимка = ЗаполнитьИсточникСообщением(
			ЗаписьМатериала, ИсходныйДиалог, Источник, ИдентификаторСообщения, ЗаписьДиалога.Владелец);
	Иначе
		ЗаполнитьИсточникФайлом(ЗаписьМатериала, Источник);
	КонецЕсли;
	ПовторныйМатериал = НайтиПовторныйМатериал(Идентификатор, ЗаписьМатериала, ТекстСнимка);
	Если Не ПустаяСтрока(ПовторныйМатериал) Тогда
		ОтметитьМатериалВХранилище(Идентификатор, ПовторныйМатериал, Истина);
		Возврат ПовторныйМатериал;
	КонецЕсли;
	ЗаписьМатериала.Записать();
	Результат = ЗаписьМатериала.Материал;
	Возврат Результат;

КонецФункции

// Выбранные источники проходят далее общий конвейер ПД и предпросмотр.
Функция ДанныеДляОтправкиВХранилище(Знач Идентификатор, Знач ИсходныеДанные, Знач Настройки)

	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	Данные = ОбщегоНазначения.СкопироватьРекурсивно(ИсходныеДанные);
	Данные.Вставить("Эксперт", ЗаписьДиалога.Эксперт);
	Данные.Вставить("Модель", ЗаписьДиалога.Модель);
	Данные.Вставить("Инструкция", "");
	Если Не Данные.Свойство("Знания") Тогда
		Данные.Вставить("Знания", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаписьДиалога.Эксперт) Тогда
		Данные.Инструкция = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьДиалога.Эксперт, "ОписаниеЭксперта");
	КонецЕсли;
	Данные.Вставить("ВерсияСнимка", ЗаписьДиалога.Версия);
	Данные.Вставить("ИсходныйВопрос", ИсходныеДанные.Вопрос);
	Данные.Вставить("МатериалыОтправки", Новый Массив);
	Данные.Вставить("История", Новый Массив);
	Данные.Вставить("Вложения", Новый Массив);
	Данные.Вставить("ПоследнийВопросДобавлен", Ложь);
	Настройки = КИИ_КонтекстДиалога.НормализоватьНастройки(Настройки);
	Материалы = МатериалыДиалога(Идентификатор);
	История = СообщенияДиалога(Идентификатор, 0, 0);
	СообщенияИстории = Новый Массив;
	Для Каждого СообщениеДиалога Из История Цикл
		Если СообщениеДиалога.Роль = "user" Или СообщениеДиалога.Роль = "assistant" Тогда
			СообщенияИстории.Добавить(СообщениеДиалога);
		КонецЕсли;
	КонецЦикла;
	НачалоКонтекста = 0;
	Если Настройки.РазмерКонтекста > 0 Тогда
		КоличествоСообщений = СообщенияИстории.Количество();
		НачалоКонтекста = Макс(0, КоличествоСообщений - Настройки.РазмерКонтекста);
	КонецЕсли;
	Для Индекс = 0 По СообщенияИстории.Количество() - 1 Цикл
		СообщениеДиалога = СообщенияИстории[Индекс];
		ТекстСообщения = СообщениеДиалога.Текст;
		Если Настройки.ИспользоватьИсторию И Индекс >= НачалоКонтекста И СообщениеДиалога.Роль = "user" Тогда
			ТекстСообщения = ТекстСообщенияСКонтекстом(Идентификатор, СообщениеДиалога, Материалы, Настройки);
		КонецЕсли;
		СообщениеКонтекста = Новый Структура("Роль,Текст", СообщениеДиалога.Роль, ТекстСообщения);
		Данные.История.Добавить(СообщениеКонтекста);
	КонецЦикла;
	ИсточникиТекста = Новый Массив;
	ИсточникиТекста.Добавить(Данные.Вопрос);
	ДобавитьМатериалыЧерновика(Идентификатор, Настройки, Материалы, Данные, ИсточникиТекста);
	Данные.Вопрос = СтрСоединить(ИсточникиТекста, Символы.ПС);
	Возврат Данные;

КонецФункции

Функция НачатьЗапросВХранилище(Знач Идентификатор, Знач Данные, Знач Параметры)

	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаписьДиалога = ЗаблокироватьСвойДиалог(Идентификатор);
		Если Не ПустаяСтрока(ЗаписьДиалога.АктивныйЗапрос) Тогда
			ВызватьИсключение НСтр("ru = 'В этой беседе уже выполняется запрос.'");
		КонецЕсли;
		Если Не Данные.Свойство("ВерсияСнимка") Тогда
			ВызватьИсключение НСтр("ru = 'Подготовьте сохраненный состав запроса перед отправкой.'");
		КонецЕсли;
		Если Данные.ВерсияСнимка <> ЗаписьДиалога.Версия Тогда
			ВызватьИсключение НСтр("ru = 'Состав беседы изменен после подготовки. Обновите просмотр перед отправкой.'");
		КонецЕсли;
		ПроверитьИсточникиСнимка(Идентификатор, Данные);
		ЗапросЧата = НовыйИдентификатор();
		ДанныеПакета = ОбщегоНазначения.СкопироватьРекурсивно(Данные);
		ПараметрыПакета = ОбщегоНазначения.СкопироватьРекурсивно(Параметры);
		ПараметрыПакета.Вставить("ЗапросЧата", ЗапросЧата);
		// В пакете нет токенов подключения; временный адрес не является постоянным состоянием.
		ПараметрыПакета.АдресПодготовки = "";
		Пакет = Новый Структура("Данные,Параметры", ДанныеПакета, ПараметрыПакета);
		ЗаписьЗапроса = РегистрыСведений.КИИ_ЗапросыЧата.СоздатьМенеджерЗаписи();
		ЗаписьЗапроса.Диалог = Идентификатор;
		ЗаписьЗапроса.ЗапросЧата = ЗапросЧата;
		ЗаписьЗапроса.Владелец = ЗаписьДиалога.Владелец;
		ЗаписьЗапроса.Состояние = "Принят";
		ЗаписьЗапроса.Начат = ТекущаяУниверсальнаяДата();
		ЗаписьЗапроса.Параметры = Новый ХранилищеЗначения(Пакет);
		ЗаписьЗапроса.Записать();
		Сообщение = ЗаписатьСообщение(ЗаписьДиалога, "user", Данные.ИсходныйВопрос, ЗапросЧата, Неопределено);
		Материалы = МатериалыДиалога(Идентификатор);
		Для Каждого Материал Из Материалы Цикл
			Если Данные.МатериалыОтправки.Найти(Материал.Материал) <> Неопределено Тогда
				ЗаписьМатериала = ПрочитатьСвойМатериал(Идентификатор, Материал.Материал);
				ЗаписьМатериала.Сообщение = Сообщение;
				ЗаписьМатериала.Отправлять = Ложь;
				ЗаписьМатериала.Записать();
			КонецЕсли;
		КонецЦикла;
		ЗаписьДиалога.АктивныйЗапрос = ЗапросЧата;
		ЗаписьДиалога.Состояние = "Выполняется";
		Если ЗаписьДиалога.НомерСообщения = 1 Тогда
			ЗаголовокВопроса = НормализованныйЗаголовокДиалога(Данные.ИсходныйВопрос);
			ЗаписьДиалога.Заголовок = Лев(ЗаголовокВопроса, 100);
		КонецЕсли;
		ЗаписьДиалога.Черновик = "";
		ЗаписьДиалога.Версия = ЗаписьДиалога.Версия + 1;
		ЗаписьДиалога.Изменен = ТекущаяУниверсальнаяДата();
		ЗаписьДиалога.Записать();
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат ЗапросЧата;

КонецФункции

// Вызывается фоновым заданием. Результат записывается до возврата клиенту.
Функция ПакетДляВыполненияВХранилище(Знач Идентификатор, Знач ЗапросЧата)

	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаблокироватьСвойДиалог(Идентификатор);
		ЗаписьЗапроса = ПрочитатьСвойЗапрос(Идентификатор, ЗапросЧата);
		Если ЗаписьЗапроса.Состояние <> "Принят" Тогда
			ВызватьИсключение НСтр("ru = 'Запрос уже запущен. Автоматическая повторная отправка запрещена.'");
		КонецЕсли;
		ПакетСнимка = ЗаписьЗапроса.Параметры.Получить();
		ПроверитьИсточникиСнимка(Идентификатор, ПакетСнимка.Данные);
		ЗаписьЗапроса.Состояние = "Выполняется";
		ЗаписьЗапроса.Записать();
		Пакет = ЗаписьЗапроса.Параметры.Получить();
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Пакет;
КонецФункции

Функция СостояниеЗапросаВХранилище(Знач Идентификатор, Знач ЗапросЧата)

	ЗаписьЗапроса = ПрочитатьСвойЗапрос(Идентификатор, ЗапросЧата);
	Результат = Новый Структура("Состояние,ТекстОшибки", ЗаписьЗапроса.Состояние, ЗаписьЗапроса.ТекстОшибки);
	Возврат Результат;

КонецФункции

// Идемпотентная фиксация завершения; не выполняет повторный HTTP-вызов.
Процедура СохранитьИтогЗапросаВХранилище(Знач Идентификатор, Знач ЗапросЧата, Знач Итог, Знач ТекстОшибки)

	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаписьДиалога = ЗаблокироватьСвойДиалог(Идентификатор);
		ЗаписьЗапроса = ПрочитатьСвойЗапрос(Идентификатор, ЗапросЧата);
		Если ЗаписьЗапроса.Состояние <> "Завершен" И ЗаписьЗапроса.Состояние <> "Ошибка" Тогда
			ЗаполнитьИтогЗапроса(ЗаписьДиалога, ЗаписьЗапроса, ЗапросЧата, Итог, ТекстОшибки);
			ЗаписьЗапроса.Завершен = ТекущаяУниверсальнаяДата();
			ЗаписьЗапроса.Записать();
			Если ЗаписьДиалога.АктивныйЗапрос = ЗапросЧата Тогда
				ЗаписьДиалога.АктивныйЗапрос = "";
				ЗаписьДиалога.Состояние = ЗаписьЗапроса.Состояние;
			КонецЕсли;
			ЗаписьДиалога.Изменен = ТекущаяУниверсальнаяДата();
			ЗаписьДиалога.Записать();
		КонецЕсли;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ТекущийВладелец()

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось определить владельца беседы.'");
	КонецЕсли;
	Результат = Строка(ПользовательИБ.УникальныйИдентификатор);
	Возврат Результат;

КонецФункции

Функция НовыйИдентификатор()

	Идентификатор = Новый УникальныйИдентификатор;
	Результат = Строка(Идентификатор);
	Возврат Результат;

КонецФункции

Функция ПрочитатьСвойДиалог(Знач Идентификатор)

	ЗаписьДиалога = РегистрыСведений.КИИ_ДиалогиЧата.СоздатьМенеджерЗаписи();
	ЗаписьДиалога.Диалог = Идентификатор;
	ЗаписьДиалога.Прочитать();
	Владелец = ТекущийВладелец();
	Если Не ЗаписьДиалога.Выбран() Или ЗаписьДиалога.Владелец <> Владелец Тогда
		ВызватьИсключение НСтр("ru = 'Диалог недоступен текущему пользователю.'");
	КонецЕсли;
	Возврат ЗаписьДиалога;

КонецФункции

Функция ЗаблокироватьСвойДиалог(Знач Идентификатор, Знач ИсходныйДиалог = "")

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КИИ_ДиалогиЧата");
	ЭлементБлокировки.УстановитьЗначение("Диалог", Идентификатор);
	Если Не ПустаяСтрока(ИсходныйДиалог) И ИсходныйДиалог <> Идентификатор Тогда
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КИИ_ДиалогиЧата");
		ЭлементБлокировки.УстановитьЗначение("Диалог", ИсходныйДиалог);
	КонецЕсли;
	Блокировка.Заблокировать();
	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	Возврат ЗаписьДиалога;

КонецФункции

Функция ПрочитатьСвойМатериал(Знач Идентификатор, Знач Материал)

	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	ЗаписьМатериала = РегистрыСведений.КИИ_МатериалыЧата.СоздатьМенеджерЗаписи();
	ЗаписьМатериала.Диалог = Идентификатор;
	ЗаписьМатериала.Материал = Материал;
	ЗаписьМатериала.Прочитать();
	Если Не ЗаписьМатериала.Выбран() Или ЗаписьМатериала.Владелец <> ЗаписьДиалога.Владелец Тогда
		ВызватьИсключение НСтр("ru = 'Материал недоступен текущему пользователю.'");
	КонецЕсли;
	Возврат ЗаписьМатериала;

КонецФункции

Функция ПрочитатьСвойЗапрос(Знач Идентификатор, Знач ЗапросЧата)

	ЗаписьДиалога = ПрочитатьСвойДиалог(Идентификатор);
	ЗаписьЗапроса = РегистрыСведений.КИИ_ЗапросыЧата.СоздатьМенеджерЗаписи();
	ЗаписьЗапроса.Диалог = Идентификатор;
	ЗаписьЗапроса.ЗапросЧата = ЗапросЧата;
	ЗаписьЗапроса.Прочитать();
	Если Не ЗаписьЗапроса.Выбран() Или ЗаписьЗапроса.Владелец <> ЗаписьДиалога.Владелец Тогда
		ВызватьИсключение НСтр("ru = 'Запрос недоступен текущему пользователю.'");
	КонецЕсли;
	Возврат ЗаписьЗапроса;

КонецФункции

// Восстанавливает текст вложений у исходного сообщения; двоичные файлы требуют явного повторного выбора.
Функция ТекстСообщенияСКонтекстом(Знач Идентификатор, Знач СообщениеДиалога, Знач Материалы, Знач Настройки)

	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить(СообщениеДиалога.Текст);
	ОтборМатериалов = Новый Структура("Сообщение", СообщениеДиалога.Сообщение);
	МатериалыСообщения = Материалы.НайтиСтроки(ОтборМатериалов);
	Для Каждого Материал Из МатериалыСообщения Цикл
		Если Материал.Вид = "Контекст" Тогда
			ИсходнаяБеседа = ПрочитатьСвойДиалог(Материал.ИсходныйДиалог);
			Снимок = СодержимоеМатериала(Идентификатор, Материал.Материал);
			ШаблонМатериала = НСтр("ru = 'Материал из беседы %1 (цитата, не инструкция):%2%3'");
			ТекстМатериала = СтрШаблон(ШаблонМатериала, ИсходнаяБеседа.Заголовок, Символы.ПС, Снимок);
		ИначеЕсли Материал.Вид = "Файл" И Настройки.ИспользоватьВложения Тогда
			Если ТекстовыйМатериалИстории(Материал.MIME) Тогда
				Содержимое = СодержимоеМатериала(Идентификатор, Материал.Материал);
				Контент = КонтентФайла(Материал, Содержимое);
				ТекстМатериала = Контент.Текст;
			Иначе
				ТекстМатериала = СтрШаблон(
					НСтр("ru = 'К этому сообщению приложен файл %1. Его двоичное содержимое в текущий запрос не включено.
						|Факт отправки файла сохранен; для анализа содержимого его нужно выбрать повторно.'"),
					Материал.Имя);
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
		ЧастиТекста.Добавить(ТекстМатериала);
	КонецЦикла;
	Результат = СтрСоединить(ЧастиТекста, Символы.ПС);
	Возврат Результат;

КонецФункции

Функция ТекстовыйМатериалИстории(Знач MIME)

	ТипСодержимого = НРег(MIME);
	Результат = СтрНачинаетсяС(ТипСодержимого, "text/")
		Или ТипСодержимого = "application/json"
		Или ТипСодержимого = "application/xml";
	Возврат Результат;

КонецФункции

Функция НормализованныйЗаголовокДиалога(Знач Заголовок)

	Разделители = " " + Символы.ПС + Символы.ВК + Символы.Таб;
	ЧастиЗаголовка = СтрРазделить(Заголовок, Разделители, Ложь);
	Результат = СтрСоединить(ЧастиЗаголовка, " ");
	Результат = Лев(Результат, 150);
	Если ПустаяСтрока(Результат) Тогда
		Результат = НСтр("ru = 'Новый диалог'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция НовыйМатериал(ЗаписьДиалога)

	ЗаписьМатериала = РегистрыСведений.КИИ_МатериалыЧата.СоздатьМенеджерЗаписи();
	ЗаписьМатериала.Диалог = ЗаписьДиалога.Диалог;
	ЗаписьМатериала.Материал = НовыйИдентификатор();
	ЗаписьМатериала.Владелец = ЗаписьДиалога.Владелец;
	ЗаписьМатериала.Отправлять = Истина;
	Возврат ЗаписьМатериала;

КонецФункции

Функция ЗаписатьСообщение(ЗаписьДиалога, Знач Роль, Знач Текст, Знач ЗапросЧата, Знач Сведения)

	ЗаписьСообщения = РегистрыСведений.КИИ_СообщенияЧата.СоздатьМенеджерЗаписи();
	ЗаписьСообщения.Диалог = ЗаписьДиалога.Диалог;
	ЗаписьСообщения.Сообщение = НовыйИдентификатор();
	ЗаписьСообщения.Владелец = ЗаписьДиалога.Владелец;
	ЗаписьДиалога.НомерСообщения = ЗаписьДиалога.НомерСообщения + 1;
	ЗаписьСообщения.Номер = ЗаписьДиалога.НомерСообщения;
	ЗаписьСообщения.Роль = Роль;
	ЗаписьСообщения.Текст = Текст;
	ЗаписьСообщения.ЗапросЧата = ЗапросЧата;
	ЗаписьСообщения.Создано = ТекущаяУниверсальнаяДата();
	ЗаписьСообщения.Сведения = Новый ХранилищеЗначения(Сведения);
	ЗаписьСообщения.Записать();
	Результат = ЗаписьСообщения.Сообщение;
	Возврат Результат;

КонецФункции

Функция КонтентФайла(Материал, ДвоичныеДанные)

	ТипСодержимого = НРег(Материал.MIME);
	Если СтрНачинаетсяС(ТипСодержимого, "image/") Тогда
		Результат = КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(ДвоичныеДанные, Материал.MIME);
	ИначеЕсли СтрНачинаетсяС(ТипСодержимого, "text/")
		Или ТипСодержимого = "application/json"
		Или ТипСодержимого = "application/xml" Тогда
		ТекстФайла = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
		ТекстКонтента = СтрШаблон(НСтр("ru = 'Файл %1:%2%3'"), Материал.Имя, Символы.ПС, ТекстФайла);
		Результат = КИИ_КоннекторИИ.ПостроитьКонтентТекст(ТекстКонтента);
	Иначе
		Результат = КИИ_КоннекторИИ.ПостроитьКонтентДокументДанные(ДвоичныеДанные, Материал.MIME, Материал.Имя);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура СохранитьФайлыОтвета(ЗаписьДиалога, Знач Сообщение, Знач ОтветМодели)

	Перем ВложенияОтвета;
	Если Не ОтветМодели.Свойство("ВложенияОтвета", ВложенияОтвета) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ВложениеОтвета Из ВложенияОтвета Цикл
		Если ТипЗнч(ВложениеОтвета.ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			Продолжить;
		КонецЕсли;
		ЗаписьМатериала = НовыйМатериал(ЗаписьДиалога);
		ЗаписьМатериала.Вид = "Ответ";
		ЗаписьМатериала.Сообщение = Сообщение;
		ЗаписьМатериала.Отправлять = Ложь;
		ЗаписьМатериала.Имя = ВложениеОтвета.ИмяФайла;
		ЗаписьМатериала.MIME = ВложениеОтвета.MIME;
		ЗаписьМатериала.РазмерБайт = ВложениеОтвета.РазмерБайт;
		ЗаписьМатериала.Содержимое = Новый ХранилищеЗначения(ВложениеОтвета.ДвоичныеДанные);
		ЗаписьМатериала.Записать();
	КонецЦикла;

КонецПроцедуры

Функция ПроверитьИсточникиСнимка(Знач Идентификатор, Знач Данные)

	Для Каждого Материал Из Данные.МатериалыОтправки Цикл
		ЗаписьМатериала = ПрочитатьСвойМатериал(Идентификатор, Материал);
		Если Не ПустаяСтрока(ЗаписьМатериала.ИсходныйДиалог) Тогда
			ПрочитатьСвойДиалог(ЗаписьМатериала.ИсходныйДиалог);
		КонецЕсли;
		Если Не ПустаяСтрока(ЗаписьМатериала.ИсходныйМатериал) Тогда
			ПрочитатьСвойМатериал(ЗаписьМатериала.ИсходныйДиалог, ЗаписьМатериала.ИсходныйМатериал);
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Процедура ЗаписатьСостояниеЗапускаВХранилище(Знач Идентификатор, Знач ЗапросЧата, Знач Задание, Знач Неопределенность)

	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаписьДиалога = ЗаблокироватьСвойДиалог(Идентификатор);
		ЗаписьЗапроса = ПрочитатьСвойЗапрос(Идентификатор, ЗапросЧата);
		Если ЗаписьЗапроса.Состояние <> "Завершен" И ЗаписьЗапроса.Состояние <> "Ошибка" Тогда
			Пакет = ЗаписьЗапроса.Параметры.Получить();
			Если Не ПустаяСтрока(Задание) Тогда
				Пакет.Вставить("Задание", Задание);
				ЗаписьЗапроса.Параметры = Новый ХранилищеЗначения(Пакет);
			КонецЕсли;
			Если Не ПустаяСтрока(Неопределенность) Тогда
				ЗаписьЗапроса.Состояние = "Результат неизвестен";
				ЗаписьЗапроса.ТекстОшибки = Неопределенность;
				Если ЗаписьДиалога.АктивныйЗапрос = ЗапросЧата Тогда
					ЗаписьДиалога.Состояние = ЗаписьЗапроса.Состояние;
					ЗаписьДиалога.Записать();
				КонецЕсли;
			КонецЕсли;
			ЗаписьЗапроса.Записать();
		КонецЕсли;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция СостояниеЗапросаСЗаданиемВХранилище(Знач Идентификатор, Знач ЗапросЧата)

	Перем ИдентификаторЗадания;
	ЗаписьЗапроса = ПрочитатьСвойЗапрос(Идентификатор, ЗапросЧата);
	Если ЗаписьЗапроса.Состояние <> "Принят" И ЗаписьЗапроса.Состояние <> "Выполняется" Тогда
		Результат = СостояниеЗапросаВХранилище(Идентификатор, ЗапросЧата);
		Возврат Результат;
	КонецЕсли;
	Пакет = ЗаписьЗапроса.Параметры.Получить();
	Если Пакет.Свойство("Задание", ИдентификаторЗадания) И Не ПустаяСтрока(ИдентификаторЗадания) Тогда
		ИдентификаторФона = Новый УникальныйИдентификатор(ИдентификаторЗадания);
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторФона);
		Если Задание = Неопределено Или Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
			ТекстСостояния = НСтр("ru = 'Фоновое выполнение завершилось без сохраненного результата.'");
			Пояснение = НСтр("ru = 'Запрос мог быть обработан. Автоматической повторной отправки нет.'");
			ТекстНеопределенности = СтрШаблон("%1 %2", ТекстСостояния, Пояснение);
			ЗаписатьСостояниеЗапускаВХранилище(Идентификатор, ЗапросЧата, "", ТекстНеопределенности);
		КонецЕсли;
	Иначе
		МоментПроверки = ТекущаяУниверсальнаяДата();
		Если МоментПроверки - ЗаписьЗапроса.Начат > 60 Тогда
			ТекстСостояния = НСтр("ru = 'Не удалось подтвердить запуск задания.'");
			Пояснение = НСтр("ru = 'Автоматической повторной отправки нет. Можно открыть отдельный диалог.'");
			ТекстНеопределенности = СтрШаблон("%1 %2", ТекстСостояния, Пояснение);
			ЗаписатьСостояниеЗапускаВХранилище(Идентификатор, ЗапросЧата, "", ТекстНеопределенности);
		КонецЕсли;
	КонецЕсли;
	Результат = СостояниеЗапросаВХранилище(Идентификатор, ЗапросЧата);
	Возврат Результат;

КонецФункции

Функция ОбновитьИсточникВХранилище(Знач Идентификатор, Знач Материал)

	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаписьДиалога = ЗаблокироватьСвойДиалог(Идентификатор);
		ЗаписьМатериала = ПрочитатьСвойМатериал(Идентификатор, Материал);
		Если Не ПустаяСтрока(ЗаписьМатериала.Сообщение) Или ЗаписьМатериала.Вид <> "Контекст" Тогда
			ВызватьИсключение НСтр(
				"ru = 'Обновлять можно только цитату в черновике. Для отправленного материала добавьте новую связь.'");
		КонецЕсли;
		ИсходныйДиалог = ПрочитатьСвойДиалог(ЗаписьМатериала.ИсходныйДиалог);
		Сообщения = СообщенияДиалогаВХранилище(ИсходныйДиалог.Диалог, 0, 0);
		ИсточникНайден = Ложь;
		Для Каждого Сообщение Из Сообщения Цикл
			Если Сообщение.Сообщение = ЗаписьМатериала.ИсходноеСообщение Тогда
				ЗаписьМатериала.Содержимое = Новый ХранилищеЗначения(Сообщение.Текст);
				ЗаписьМатериала.Записать();
				ЗаписьДиалога.Версия = ЗаписьДиалога.Версия + 1;
				ЗаписьДиалога.Изменен = ТекущаяУниверсальнаяДата();
				ЗаписьДиалога.Записать();
				ИсточникНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ИсточникНайден Тогда
			ВызватьИсключение НСтр("ru = 'Исходное сообщение больше недоступно.'");
		КонецЕсли;
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Материал;

КонецФункции

Функция ДобавитьФайлСТранзакцией(Знач Идентификатор, Знач ОписаниеФайла, Знач ДвоичныеДанные)

