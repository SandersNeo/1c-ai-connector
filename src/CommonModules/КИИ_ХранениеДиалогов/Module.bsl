	Попытка
		ЗаписьДиалога = ЗаблокироватьСвойДиалог(Идентификатор);
		Результат = ДобавитьФайлВХранилище(Идентификатор, ОписаниеФайла, ДвоичныеДанные);
		ЗаписьДиалога.Версия = ЗаписьДиалога.Версия + 1;
		ЗаписьДиалога.Изменен = ТекущаяУниверсальнаяДата();
