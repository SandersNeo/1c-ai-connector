КонецПроцедуры

&НаКлиенте
Процедура НачатьПодготовкуКонтекста(Знач Режим)

	Перем ТекстСообщения2;
	Перем ДанныеОшибки;
	Если Не ПредыдущийЗапросЗавершен() Тогда
		ТекстСообщения2 = НСтр("ru = 'Предыдущая операция ещё выполняется. Дождитесь её завершения.'");
		ПоказатьПредупреждение(, ТекстСообщения2);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Эксперт) Или ПустаяСтрока(Промпт) Тогда
		ИнвалидироватьПросмотр();
		Возврат;
	КонецЕсли;
	Попытка
		Операция = НачатьОперациюКонтекстаНаСервере(Промпт, Режим, Ложь);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ПросмотрСтатус = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
		ПросмотрГотово = Ложь;
		Возврат;
	КонецПопытки;
	Элементы.Отправить.Доступность = Ложь;
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	Если Режим = "Знания" Тогда
		ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Поиск знаний через модель эмбеддингов...'");
	Иначе
		ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Подготовка просмотра контекста...'");
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеПодготовкиКонтекста", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодготовкиКонтекста(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		ЗаданиеДиалога = "";
	КонецЕсли;
	Элементы.Отправить.Доступность = Истина;
	Если Результат = Неопределено Тогда
		ПросмотрГотово = Ложь;
		ПросмотрСтатус = НСтр(
			"ru = 'Ожидание отменено. Подготовка может продолжаться; дождитесь завершения операции.'");
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		ПросмотрГотово = Ложь;
		ПросмотрСтатус = Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Выполнено" Тогда
		Итог = ПолучитьРезультатИзАдреса(Результат.АдресРезультата);
		Если Итог <> Неопределено Тогда
			ПрименитьПредпросмотр(Итог.Представление);
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПередОтправкой;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПредпросмотр(Знач Представление)
	ПросмотрСтатус = Представление.Статус;
	ПросмотрГотово = Представление.Готово;
	ПросмотрПолучатель = Представление.Получатель;
	ПросмотрИнструкция = Представление.Инструкция;
	ПросмотрВопрос = Представление.Вопрос;
	ПросмотрЗнания = Представление.Знания;
	ПросмотрСообщения = Представление.Сообщения;
	ПросмотрИнструменты = Представление.Инструменты;
	ПросмотрВложения = Представление.Вложения;
	Если ПустаяСтрока(ПросмотрИнструкция) Тогда
		ПросмотрИнструкция = НСтр("ru = 'Дополнительная инструкция эксперта отсутствует.'");
	КонецЕсли;
	Если ПустаяСтрока(ПросмотрЗнания) Тогда
		Если ИспользоватьЗнания Тогда
			ПросмотрЗнания = НСтр(
				"ru = 'Фрагменты знаний не подобраны. Нажмите «Подобрать знания» для текущего вопроса.'");
		Иначе
			ПросмотрЗнания = НСтр("ru = 'Знания исключены из запроса в настройках диалога.'");
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(ПросмотрВложения) Тогда
		ПросмотрВложения = НСтр(
			"ru = 'В запросе нет вложений. Добавьте материалы на вкладке «Диалог» и отметьте их для отправки.'");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НастройкиКонтекстаДиалога()

	Перем РезультатФункции;
	СтруктураЗначений = Новый Структура;
	СтруктураЗначений.Вставить("ИспользоватьИсторию", ИспользоватьИсторию);
	СтруктураЗначений.Вставить("ИспользоватьЗнания", ИспользоватьЗнания);
	СтруктураЗначений.Вставить("ИспользоватьВложения", ИспользоватьВложения);
	СтруктураЗначений.Вставить("РазмерКонтекста", РазмерКонтекста);
	Настройки = СтруктураЗначений;
	РезультатФункции = КИИ_КонтекстДиалога.НормализоватьНастройки(Настройки);
	Возврат РезультатФункции;
КонецФункции

&НаСервере
Функция ДанныеКонтекстаДиалога(Знач Вопрос, Знач ПоследнийВопросДобавлен)
	ИсходныеДанные = Новый Структура("Вопрос,Знания", Вопрос, "");
	Настройки = НастройкиКонтекстаДиалога();
	Результат = КИИ_ХранениеДиалогов.ДанныеДляОтправки(ИдентификаторДиалога, ИсходныеДанные, Настройки);
	Возврат Результат;
КонецФункции

&НаСервере
Функция НачатьОперациюКонтекстаНаСервере(Знач Вопрос, Знач Режим, Знач ПоследнийВопросДобавлен)
	Перем ИдентификаторЗадания;
	СохранитьЧерновикДиалогаНаСервере();
	Данные = ДанныеКонтекстаДиалога(Вопрос, Ложь);
	ПараметрыОперации = Новый Структура;
	Настройки = НастройкиКонтекстаДиалога();
	Базы = ВыбранныеИсточникиДиалога();
	ПараметрыОперации.Вставить("Настройки", Настройки);
	ПараметрыОперации.Вставить("ИспользоватьИнструменты", ИспользоватьИнструменты);
	ПараметрыОперации.Вставить("Базы", Базы);
	ПараметрыОперации.Вставить("Диалог", ИдентификаторДиалога);
	ПараметрыОперации.Вставить("ВладелецФормы", УникальныйИдентификатор);
	ПараметрыОперации.Вставить("АдресПодготовки", АдресПодготовкиДиалога);
	Выполнение = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Выполнение.ЗапуститьВФоне = Истина;
	Выполнение.ОжидатьЗавершение = 0;
	Если Режим = "Отправка" Тогда
		АктивныйЗапросДиалога = КИИ_ХранениеДиалогов.НачатьЗапрос(ИдентификаторДиалога, Данные, ПараметрыОперации);
		СнимокБеседы = КИИ_ХранениеДиалогов.Диалог(ИдентификаторДиалога);
		ВерсияДиалога = СнимокБеседы.Версия;
		Промпт = "";
		ЧерновикИзменен = Ложь;
		Попытка
			Операция = ДлительныеОперации.ВыполнитьФункцию(
				Выполнение, "КИИ_ХранениеДиалогов.ВыполнитьЗапрос", ИдентификаторДиалога, АктивныйЗапросДиалога);
			Если Операция <> Неопределено
				И Операция.Свойство("ИдентификаторЗадания", ИдентификаторЗадания)
				И ИдентификаторЗадания <> Неопределено Тогда
				ИдентификаторСтрокой = Строка(ИдентификаторЗадания);
				КИИ_ХранениеДиалогов.ЗаписатьСостояниеЗапуска(
					ИдентификаторДиалога, АктивныйЗапросДиалога, ИдентификаторСтрокой, "");
			Иначе
				ТекстНеопределенности = НСтр(
					"ru = 'Запуск не подтвержден. Запрос мог быть обработан; автоматического повтора нет.'");
				КИИ_ХранениеДиалогов.ЗаписатьСостояниеЗапуска(
					ИдентификаторДиалога, АктивныйЗапросДиалога, "", ТекстНеопределенности);
			КонецЕсли;
		Исключение
			ДанныеОшибки = ИнформацияОбОшибке();
			ТекстНеопределенности = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
			КИИ_ХранениеДиалогов.ЗаписатьСостояниеЗапуска(
				ИдентификаторДиалога, АктивныйЗапросДиалога, "", ТекстНеопределенности);
			ВызватьИсключение;
		КонецПопытки;
	Иначе
		Операция = ДлительныеОперации.ВыполнитьФункцию(
			Выполнение, "КИИ_КонтекстДиалога.ВыполнитьОперацию", Данные, ПараметрыОперации, Режим);
		ЗаданиеДиалога = Строка(Операция.ИдентификаторЗадания);
		АдресРезультатаДиалога = Операция.АдресРезультата;
	КонецЕсли;
	Возврат Операция;
КонецФункции

&НаКлиенте
Процедура ОбновитьЖурналДиалога(Команда)
	ОбновитьЖурналДиалогаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьЖурналДиалогаНаСервере()

	Перем ТекстСообщения;
	Перем КоличествоЭлементов;
	ЖурналДиалога.Очистить();
	КонтекстЗаписиДиалога = "";
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.КИИ_ЛогЗапросовИИ) Тогда
		СостояниеЖурналаДиалога = НСтр("ru = 'Нет права чтения журнала запросов к ИИ.'");
		Возврат;
	КонецЕсли;
	Для Каждого ЗаписьЖурнала Из КИИ_КонтекстДиалога.ЖурналДиалога(ИдентификаторДиалога) Цикл
		СтрокаЖурнала = ЖурналДиалога.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЖурнала, ЗаписьЖурнала);
		СтрокаЖурнала.КлючЗаписи = Строка(ЗаписьЖурнала.Идентификатор);
		СтрокаЖурнала.ИмяМодели = Строка(ЗаписьЖурнала.Модель);
		СтрокаЖурнала.Состояние = ?(ЗаписьЖурнала.ЭтоОшибка, НСтр("ru = 'Ошибка'"), НСтр("ru = 'Ответ'"));
		Если ЗаписьЖурнала.ИзКеша Тогда
			СтрокаЖурнала.Состояние = НСтр("ru = 'Ответ из кеша'");
		КонецЕсли;
	КонецЦикла;
	ТекстСообщения = НСтр("ru = 'Записей этой беседы: %1. Чтобы увидеть новые записи, нажмите «Обновить журнал».'");
	КоличествоЭлементов = ЖурналДиалога.Количество();
	СостояниеЖурналаДиалога = СтрШаблон(ТекстСообщения, КоличествоЭлементов);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКонтекстРаунда(Команда)
	СтрокаЖурнала = Элементы.ЖурналДиалога.ТекущиеДанные;
	Если СтрокаЖурнала = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КонтекстЗаписиДиалога = ПрочитатьКонтекстРаундаНаСервере(
		СтрокаЖурнала.КлючЗаписи, СтрокаЖурнала.УниверсальнаяДатаВМиллисекундах);
КонецПроцедуры

&НаСервере
Функция ПрочитатьКонтекстРаундаНаСервере(Знач КлючЗаписи, Знач ДатаВМиллисекундах)

	Перем РезультатФункции;
	// Повторный отбор по действующим правам, владельцу и диалогу; строке клиентской таблицы не доверяем.
	Для Каждого ЗаписьЖурнала Из КИИ_КонтекстДиалога.ЖурналДиалога(ИдентификаторДиалога) Цикл
		Если Строка(ЗаписьЖурнала.Идентификатор) = КлючЗаписи
			И ЗаписьЖурнала.УниверсальнаяДатаВМиллисекундах = ДатаВМиллисекундах Тогда
			ЗаголовокВопроса = НСтр("ru = 'Вопрос после обработки ПД:'");
			ЗаголовокИнструкции = НСтр("ru = 'Инструкция после обработки ПД:'");
			ЗаголовокИстории = НСтр("ru = 'Сохранённые сообщения и инструменты:'");
			ЗаголовокОтвета = НСтр("ru = 'Ответ модели:'");
			ЧастиКонтекста = Новый Массив;
			ЧастиКонтекста.Добавить(ЗаголовокВопроса);
			ЧастиКонтекста.Добавить(ЗаписьЖурнала.ПользовательскийПромпт);
			ЧастиКонтекста.Добавить(ЗаголовокИнструкции);
			ЧастиКонтекста.Добавить(ЗаписьЖурнала.СистемныйПромпт);
			ЧастиКонтекста.Добавить(ЗаголовокИстории);
			ЧастиКонтекста.Добавить(ЗаписьЖурнала.ИсторияСообщенийJSON);
			ЧастиКонтекста.Добавить(ЗаголовокОтвета);
			ЧастиКонтекста.Добавить(ЗаписьЖурнала.ТекстОтвета);
			ЧастиКонтекста.Добавить(ЗаписьЖурнала.ТекстОшибки);
			РезультатФункции = СтрСоединить(ЧастиКонтекста, Символы.ПС);
			Возврат РезультатФункции;
		КонецЕсли;
	КонецЦикла;
	РезультатФункции = НСтр("ru = 'Запись недоступна в указанном диалоге.'");
	Возврат РезультатФункции;
КонецФункции

&НаСервере
Процедура НачатьНовыйДиалогКонтекстаНаСервере()
	ИдентификаторДиалога = Строка(Новый УникальныйИдентификатор);
	ПоместитьВоВременноеХранилище(Неопределено, АдресПодготовкиДиалога);
	ЖурналДиалога.Очистить();
	КонтекстЗаписиДиалога = "";
	СостояниеЗапросаДиалога = "";
КонецПроцедуры

&НаКлиенте
Процедура СохранениеИОбновлениеДиалога() Экспорт
	Попытка
		Если ЧерновикИзменен Тогда
			СохранитьЧерновикДиалогаНаСервере();
		КонецЕсли;
		Если Не ПустаяСтрока(АктивныйЗапросДиалога) Тогда
			ОбновитьСохраненнуюИсториюНаСервере();
		КонецЕсли;
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		СтатусДиалога = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция НастройкиДляХраненияДиалога()
	Настройки = НастройкиКонтекстаДиалога();
	Базы = ВыбранныеИсточникиДиалога();
	Настройки.Вставить("Базы", Базы);
	Настройки.Вставить("ИспользоватьИнструменты", ИспользоватьИнструменты);
	Настройки.Вставить("Модель", Модель);
	Возврат Настройки;
КонецФункции

&НаСервере
Процедура СохранитьЧерновикДиалогаНаСервере()
	Если ПустаяСтрока(ИдентификаторДиалога) Тогда
		Возврат;
	КонецЕсли;
	Настройки = НастройкиДляХраненияДиалога();
	ВерсияДиалога = КИИ_ХранениеДиалогов.СохранитьЧерновик(
		ИдентификаторДиалога, Промпт, Эксперт, Настройки, ВерсияДиалога);
	ЧерновикИзменен = Ложь;
КонецПроцедуры

&НаСервере
Процедура УстановитьМодельЭкспертаНаСервере()
	Модель = Справочники.КИИ_МоделиИИ.ПустаяСсылка();
	Если ЗначениеЗаполнено(Эксперт) Тогда
		Модель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эксперт, "Модель");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СоздатьНовуюБеседуНаСервере()
	Настройки = НастройкиДляХраненияДиалога();
	Результат = КИИ_ХранениеДиалогов.СоздатьДиалог(Эксперт, Настройки);
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПереименоватьБеседуНаСервере()
	КИИ_ХранениеДиалогов.ПереименоватьДиалог(ИдентификаторДиалога, ЗаголовокДиалога);
	Заголовок = СтрШаблон(НСтр("ru = 'ИИкона - %1'"), ЗаголовокДиалога);
КонецПроцедуры

&НаСервере
Процедура ОбновитьВерсиюДиалога()
	СнимокБеседы = КИИ_ХранениеДиалогов.Диалог(ИдентификаторДиалога);
	ВерсияДиалога = СнимокБеседы.Версия;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьБеседуНаСервере()
	СнимокБеседы = КИИ_ХранениеДиалогов.Диалог(ИдентификаторДиалога);
	Эксперт = СнимокБеседы.Эксперт;
	Модель = СнимокБеседы.Модель;
	Промпт = СнимокБеседы.Черновик;
	ЗаголовокДиалога = СнимокБеседы.Заголовок;
	ВерсияДиалога = СнимокБеседы.Версия;
	ЧерновикИзменен = Ложь;
	Настройки = СнимокБеседы.Настройки;
	НастройкиКонтекста = КИИ_КонтекстДиалога.НормализоватьНастройки(Настройки);
	ИспользоватьИсторию = НастройкиКонтекста.ИспользоватьИсторию;
	ИспользоватьЗнания = НастройкиКонтекста.ИспользоватьЗнания;
	ИспользоватьВложения = НастройкиКонтекста.ИспользоватьВложения;
	РазмерКонтекста = НастройкиКонтекста.РазмерКонтекста;
	Если Настройки.Свойство("ИспользоватьИнструменты") Тогда
		ИспользоватьИнструменты = Настройки.ИспользоватьИнструменты;
	КонецЕсли;
	Если Настройки.Свойство("Базы") Тогда
		Для Каждого Источник Из ИсточникиДиалога Цикл
			Источник.Выбран = Настройки.Базы.Найти(Источник.Идентификатор) <> Неопределено;
		КонецЦикла;
	КонецЕсли;
	Заголовок = СтрШаблон(НСтр("ru = 'ИИкона - %1'"), ЗаголовокДиалога);
	ОбновитьСохраненнуюИсториюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВосстановитьСостояниеПослеСбояНаСервере()
	СнимокБеседы = КИИ_ХранениеДиалогов.Диалог(ИдентификаторДиалога);
	АктивныйЗапросДиалога = СнимокБеседы.АктивныйЗапрос;
	Если Не ПустаяСтрока(АктивныйЗапросДиалога) Тогда
		Промпт = СнимокБеседы.Черновик;
		ВерсияДиалога = СнимокБеседы.Версия;
	КонецЕсли;
	ОбновитьСохраненнуюИсториюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСохраненнуюИсториюНаСервере()
	СнимокБеседы = КИИ_ХранениеДиалогов.Диалог(ИдентификаторДиалога);
	ОбновитьСтатусСохраненнойБеседы(СнимокБеседы);
	Если НомерПрочитанногоСообщения = СнимокБеседы.НомерСообщения
		И ВерсияПрочитанныхМатериалов = СнимокБеседы.Версия Тогда
		Возврат;
	КонецЕсли;
	История = КИИ_ХранениеДиалогов.СообщенияДиалога(ИдентификаторДиалога, 0, 0);
	Материалы = КИИ_ХранениеДиалогов.МатериалыДиалога(ИдентификаторДиалога);
	ОбновитьМатериалыСохраненнойБеседы(Материалы);
	ОбновитьСообщенияСохраненнойБеседы(История);
	ОбновитьСостояниеВложений();
	ОбновитьОтображениеОтвета();
	ОбновитьЗаголовокМатериаловБеседы();
	НомерПрочитанногоСообщения = СнимокБеседы.НомерСообщения;
	ВерсияПрочитанныхМатериалов = СнимокБеседы.Версия;
КонецПроцедуры

&НаСервере
Процедура ОтметитьМатериалНаСервере(Знач Материал, Знач Отправлять)
	СохранитьЧерновикДиалогаНаСервере();
	КИИ_ХранениеДиалогов.ОтметитьМатериал(ИдентификаторДиалога, Материал, Отправлять);
	ОбновитьВерсиюДиалога();
	ОбновитьСохраненнуюИсториюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораБеседы(Диалог, ДополнительныеПараметры) Экспорт
	Если Диалог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыОткрытия = Новый Структура("Диалог", Диалог);
	ОткрытьФорму("Обработка.КИИ_ТестИИ.Форма.Форма", ПараметрыОткрытия, , Диалог);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораМатериалов(Источники, ДополнительныеПараметры) Экспорт
	Если Источники = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДобавитьИсточникиНаСервере(Источники);
	ИнвалидироватьПросмотр();
КонецПроцедуры

&НаСервере
Процедура ДобавитьИсточникиНаСервере(Знач Источники)
	СохранитьЧерновикДиалогаНаСервере();
	Для Каждого Источник Из Источники Цикл
		Материал = КИИ_ХранениеДиалогов.ДобавитьИсточник(ИдентификаторДиалога, Источник);
	КонецЦикла;
	ОбновитьВерсиюДиалога();
	ОбновитьСохраненнуюИсториюНаСервере();
	Элементы.МатериалыБеседы.Видимость = Истина;
КонецПроцедуры

&НаСервере
Процедура ОбновитьЦитатуНаСервере(Знач Материал)
	КИИ_ХранениеДиалогов.ОбновитьИсточник(ИдентификаторДиалога, Материал);
	ОбновитьВерсиюДиалога();
	ОбновитьСохраненнуюИсториюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусСохраненнойБеседы(СнимокБеседы)
	АктивныйЗапросДиалога = СнимокБеседы.АктивныйЗапрос;
	СтатусДиалога = СнимокБеседы.Состояние;
	Если Не ПустаяСтрока(АктивныйЗапросДиалога) Тогда
		СостояниеЗапроса = КИИ_ХранениеДиалогов.СостояниеЗапросаСЗаданием(ИдентификаторДиалога, АктивныйЗапросДиалога);
		СтатусДиалога = СтрШаблон(НСтр("ru = '%1. Можно работать в другом диалоге.'"), СостояниеЗапроса.Состояние);
		Если Не ПустаяСтрока(СостояниеЗапроса.ТекстОшибки) Тогда
			СтатусДиалога = СтрШаблон("%1 %2", СтатусДиалога, СостояниеЗапроса.ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	Элементы.Отправить.Доступность = ПустаяСтрока(АктивныйЗапросДиалога) И ПустаяСтрока(ЗаданиеДиалога);
	ЗаголовокДиалога = СнимокБеседы.Заголовок;
	Заголовок = СтрШаблон(НСтр("ru = 'ИИкона - %1'"), ЗаголовокДиалога);
КонецПроцедуры

&НаСервере
Процедура ОбновитьМатериалыСохраненнойБеседы(Материалы)
	УбратьВсеВложения();
	Для Каждого Материал Из Материалы Цикл
		НоваяСтрока = ТаблицаВложений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Материал);
		Если Материал.Вид = "Ответ" Тогда
			НоваяСтрока.Направление = "Сгенерировано";
		ИначеЕсли ПустаяСтрока(Материал.Сообщение) Тогда
			НоваяСтрока.Направление = "Исходящее";
		Иначе
			НоваяСтрока.Направление = "Отправлено";
		КонецЕсли;
		ПоместитьСодержимоеМатериалаБеседы(НоваяСтрока, Материал);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПоместитьСодержимоеМатериалаБеседы(СтрокаВложения, Материал)
	Попытка
		Содержимое = КИИ_ХранениеДиалогов.СодержимоеМатериала(ИдентификаторДиалога, Материал.Материал);
		Если ТипЗнч(Содержимое) = Тип("Строка") Тогда
			Содержимое = ПолучитьДвоичныеДанныеИзСтроки(Содержимое, КодировкаТекста.UTF8);
		КонецЕсли;
		СтрокаВложения.Адрес = ПоместитьВоВременноеХранилище(Содержимое, УникальныйИдентификатор);
	Исключение
		СтрокаВложения.Состояние = НСтр("ru = 'Источник недоступен: исключите его из отправки или выберите заново.'");
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСообщенияСохраненнойБеседы(История)
	ИсторияДиалога.Очистить();
	Для Каждого Сообщение Из История Цикл
		НоваяСтрока = ИсторияДиалога.Добавить();
		НоваяСтрока.Роль = Сообщение.Роль;
		НоваяСтрока.Текст = Сообщение.Текст;
		Если Сообщение.Роль = "assistant" Тогда
			НоваяСтрока.Метаинформация = МетаинформацияСохраненногоОтвета(Сообщение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция МетаинформацияСохраненногоОтвета(Сообщение)
	Результат = "";
	СведенияОтвета = Сообщение.Сведения.Получить();
	Если ТипЗнч(СведенияОтвета) = Тип("Структура") И СведенияОтвета.Свойство("МодельОтвета") Тогда
		Результат = СформироватьМетаинформацию(СведенияОтвета);
	КонецЕсли;
	ИндексыКартинок = ИндексыИзображенийОтвета(Сообщение.Сообщение);
	Если ИндексыКартинок.Количество() > 0 Тогда
		СписокИндексов = СтрСоединить(ИндексыКартинок, ",");
		Результат = СтрШаблон("%1[[КИИ_ИЗО:%2]]", Результат, СписокИндексов);
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ИндексыИзображенийОтвета(ИдентификаторСообщения)
	Результат = Новый Массив;
	ИндексКартинки = 0;
	Для Каждого ФайлОтвета Из ТаблицаВложений Цикл
		Если ФайлОтвета.Направление <> "Сгенерировано" Тогда
			Продолжить;
		КонецЕсли;
		Если ФайлОтвета.Сообщение = ИдентификаторСообщения И СтрНачинаетсяС(ФайлОтвета.MIME, "image/") Тогда
			ИндексСтрокой = Строка(ИндексКартинки);
			Результат.Добавить(ИндексСтрокой);
		КонецЕсли;
		ИндексКартинки = ИндексКартинки + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ОбновитьЗаголовокМатериаловБеседы()
	КоличествоВыбранных = 0;
	Для Каждого СтрокаМатериала Из ТаблицаВложений Цикл
		Если СтрокаМатериала.Отправлять Тогда
			КоличествоВыбранных = КоличествоВыбранных + 1;
		КонецЕсли;
	КонецЦикла;
	Элементы.ПоказатьМатериалы.Заголовок = СтрШаблон(НСтр("ru = 'Материалы (%1)'"), КоличествоВыбранных);
КонецПроцедуры

#КонецОбласти
