	ПросмотрПолучатель = НСтр("ru = 'Здесь будут показаны модель и адрес получателя.'");
	ПросмотрИнструкция = НСтр(
		"ru = 'Здесь будут показаны инструкция эксперта и контекст после обработки персональных данных.'");
	ПросмотрВопрос = НСтр("ru = 'Здесь будет показан текст вопроса после обработки персональных данных.'");
	ПросмотрЗнания = НСтр("ru = 'Здесь будут показаны подобранные фрагменты знаний и их источники.'");
	ПросмотрСообщения = НСтр(
		"ru = 'Здесь будут показаны сообщения, включённые в запрос: история беседы и текущий вопрос.'");
	ПросмотрИнструменты = НСтр("ru = 'Здесь будут показаны инструменты, которые модель сможет запросить у 1С.'");
	ПросмотрВложения = НСтр(
		"ru = 'Здесь будут показаны выбранные материалы и способ их передачи: текст или двоичные данные.'");
КонецПроцедуры

