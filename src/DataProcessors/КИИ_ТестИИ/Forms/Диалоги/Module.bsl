#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РежимВыбора = "Открытие";
	Если ЗначениеЗаполнено(Параметры.РежимВыбора) Тогда
		РежимВыбора = Параметры.РежимВыбора;
	КонецЕсли;
	ВыборМатериалов = РежимВыбора = "Контекст";
	Команды.УдалитьДиалог.Картинка = БиблиотекаКартинок.Удалить;
	Команды.УдалитьДиалог.Подсказка = НСтр("ru = 'Удалить все выделенные диалоги вместе с историей и вложениями.'");
	Элементы.УдалитьДиалог.Видимость = Не ВыборМатериалов;
	ПояснениеВыбора = НСтр(
		"ru = 'Выберите беседу, затем отметьте нужные сообщения или файлы.
			|Нажмите «Добавить выбранное». Цитату можно указать для одного сообщения.'");
	Элементы.ПояснениеВыбора.Видимость = ВыборМатериалов;
	Элементы.Материалы.Видимость = ВыборМатериалов;
	Элементы.ОтметитьСообщения.Видимость = ВыборМатериалов;
	Элементы.СнятьВыбор.Видимость = ВыборМатериалов;
	Если ВыборМатериалов Тогда
		Заголовок = НСтр("ru = 'Добавить материалы из своей беседы'");
		Элементы.Выбрать.Заголовок = НСтр("ru = 'Добавить выбранное'");
	КонецЕсли;
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДиалогиПриАктивизацииСтроки(Элемент)
	ОтключитьОбработчикОжидания("ЗагрузитьМатериалыВыбора");
	Если РежимВыбора <> "Контекст" Тогда
		Возврат;
	КонецЕсли;
	Сообщения.Очистить();
	Файлы.Очистить();
	Цитата = "";
	ПодключитьОбработчикОжидания("ЗагрузитьМатериалыВыбора", 0.2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМатериалыВыбора() Экспорт
	ТекущаяБеседа = Элементы.СписокДиалогов.ТекущиеДанные;
	Если ТекущаяБеседа = Неопределено Или РежимВыбора <> "Контекст" Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьМатериалыНаСервере(ТекущаяБеседа.Диалог);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииВыбора()
	ОтключитьОбработчикОжидания("ЗагрузитьМатериалыВыбора");
КонецПроцедуры

&НаКлиенте
Процедура СообщенияПриАктивизацииСтроки(Элемент)
	ТекущееСообщение = Элементы.СписокСообщений.ТекущиеДанные;
	Если ТекущееСообщение <> Неопределено Тогда
		Цитата = ТекущееСообщение.Текст;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	ТекущаяБеседа = Элементы.СписокДиалогов.ТекущиеДанные;
	Если ТекущаяБеседа = Неопределено Тогда
		ТекстПредупреждения = НСтр("ru = 'Выберите свою беседу из списка.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	Если РежимВыбора = "Открытие" Тогда
		Закрыть(ТекущаяБеседа.Диалог);
		Возврат;
	КонецЕсли;
	Источники = ВыбранныеИсточникиБеседы(ТекущаяБеседа.Диалог);
	Если Источники.Количество() = 0 Тогда
		ТекстПредупреждения = НСтр(
			"ru = 'Отметьте нужные сообщения или файлы. Для всей беседы выберите «Все сообщения».'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	Закрыть(Источники);
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьСообщения(Команда)
	Если Элементы.СтраницыМатериалов.ТекущаяСтраница = Элементы.СтраницаФайлы Тогда
		Для Каждого Файл Из Файлы Цикл
			Файл.Выбор = Истина;
		КонецЦикла;
	Иначе
		Для Каждого Сообщение Из Сообщения Цикл
			Сообщение.Выбор = Истина;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыбор(Команда)
	Для Каждого Сообщение Из Сообщения Цикл
		Сообщение.Выбор = Ложь;
	КонецЦикла;
	Для Каждого Файл Из Файлы Цикл
		Файл.Выбор = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДиалог(Команда)

	// У списка нет отдельного сохранения: удаление подтверждается и выполняется сразу.
	Модифицированность = Ложь;
	Идентификаторы = ВыбранныеДиалогиДляУдаления();
	Если Идентификаторы.Количество() = 0 Тогда
		ТекстПредупреждения = НСтр("ru = 'Выберите диалоги для удаления.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	Беседы = БеседыДляУдаленияНаСервере(Идентификаторы);
	КоличествоБесед = Беседы.Количество();
	Если КоличествоБесед = 1 Тогда
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Удалить диалог «%1»?
				|История, черновик и вложения этого диалога будут удалены без возможности восстановления.
				|Технический журнал запросов сохраняется.'"), Беседы[0].Заголовок);
	Иначе
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Удалить выбранные диалоги (%1)?
				|История, черновики и вложения выбранных диалогов будут удалены без возможности восстановления.
				|Технический журнал запросов сохраняется.'"), КоличествоБесед);
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУдаленияДиалога", ЭтотОбъект, Беседы);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияУдаленияДиалога(РезультатВопроса, Беседы) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьДиалогиНаСервере(Беседы);
	Для Каждого Беседа Из Беседы Цикл
		Оповестить("КИИ_ДиалогУдален", Беседа.Диалог);
	КонецЦикла;

КонецПроцедуры

// Возвращает снимок выделения; текущая строка используется только при пустом выделении.
//
// Возвращаемое значение:
//  Массив из Строка - идентификаторы выбранных собственных бесед.
//
&НаКлиенте
Функция ВыбранныеДиалогиДляУдаления() Экспорт

	Идентификаторы = Новый Массив;
	ВыделенныеСтроки = Элементы.СписокДиалогов.ВыделенныеСтроки;
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		Беседа = Диалоги.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Беседа = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Список диалогов изменился. Обновите его и повторите выделение.'");
		КонецЕсли;
		Идентификаторы.Добавить(Беседа.Диалог);
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		ТекущаяБеседа = Элементы.СписокДиалогов.ТекущиеДанные;
		Если ТекущаяБеседа <> Неопределено Тогда
			Идентификаторы.Добавить(ТекущаяБеседа.Диалог);
		КонецЕсли;
	КонецЕсли;
	Возврат Идентификаторы;

КонецФункции

&НаСервереБезКонтекста
Функция БеседыДляУдаленияНаСервере(Знач Идентификаторы)

	Беседы = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Беседа = КИИ_ХранениеДиалогов.Диалог(Идентификатор);
		Если Не ПустаяСтрока(Беседа.АктивныйЗапрос) Тогда
			ВызватьИсключение НСтр(
				"ru = 'В беседе есть незавершенный запрос. Дождитесь его завершения перед удалением.'");
		КонецЕсли;
		ПодтверждениеБеседы = Новый Структура(
			"Диалог,Заголовок,Версия", Беседа.Диалог, Беседа.Заголовок, Беседа.Версия);
		Беседы.Добавить(ПодтверждениеБеседы);
	КонецЦикла;
	Возврат Беседы;

КонецФункции

&НаСервере
Процедура УдалитьДиалогиНаСервере(Знач Беседы)

	КИИ_ХранениеДиалогов.УдалитьДиалоги(Беседы);
	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()
	Диалоги.Очистить();
	ДоступныеБеседы = КИИ_ХранениеДиалогов.МоиДиалоги();
	Для Каждого Беседа Из ДоступныеБеседы Цикл
		СтрокаБеседы = Диалоги.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаБеседы, Беседа);
	КонецЦикла;
	Сообщения.Очистить();
	Файлы.Очистить();
	Цитата = "";
КонецПроцедуры

&НаСервере
Процедура ПрочитатьМатериалыНаСервере(Знач Диалог)
	Сообщения.Очистить();
	Файлы.Очистить();
	Цитата = "";
	ДоступныеСообщения = КИИ_ХранениеДиалогов.СообщенияДиалога(Диалог, 0, 0);
	Для Каждого Сообщение Из ДоступныеСообщения Цикл
		СтрокаСообщения = Сообщения.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСообщения, Сообщение);
	КонецЦикла;
	ДоступныеМатериалы = КИИ_ХранениеДиалогов.МатериалыДиалога(Диалог);
	Для Каждого Материал Из ДоступныеМатериалы Цикл
		Если Материал.Вид <> "Контекст" Тогда
			СтрокаФайла = Файлы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаФайла, Материал);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ВыбранныеИсточникиБеседы(Знач ИдентификаторБеседы)
	Источники = Новый Массив;
	ЧислоСообщений = 0;
	Для Каждого Сообщение Из Сообщения Цикл
		Если Сообщение.Выбор Тогда
			ЧислоСообщений = ЧислоСообщений + 1;
		КонецЕсли;
	КонецЦикла;
	ТекущееСообщение = Элементы.СписокСообщений.ТекущиеДанные;
	Для Каждого Сообщение Из Сообщения Цикл
		Если Не Сообщение.Выбор Тогда
			Продолжить;
		КонецЕсли;
		Источник = Новый Структура("Диалог,Сообщение", ИдентификаторБеседы, Сообщение.Сообщение);
		МожноПрименитьЦитату = ЧислоСообщений = 1 И ТекущееСообщение <> Неопределено;
		Если МожноПрименитьЦитату Тогда
			МожноПрименитьЦитату = ТекущееСообщение.Сообщение = Сообщение.Сообщение И Цитата <> Сообщение.Текст;
		КонецЕсли;
		Если МожноПрименитьЦитату Тогда
			Источник.Вставить("Фрагмент", Цитата);
		КонецЕсли;
		Источники.Добавить(Источник);
	КонецЦикла;
	Для Каждого Файл Из Файлы Цикл
		Если Файл.Выбор Тогда
			Источник = Новый Структура("Диалог,Материал", ИдентификаторБеседы, Файл.Материал);
			Источники.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Источники;
КонецФункции

#КонецОбласти
