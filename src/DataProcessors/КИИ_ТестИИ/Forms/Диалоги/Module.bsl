#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РежимВыбора = "Открытие";
	Если ЗначениеЗаполнено(Параметры.РежимВыбора) Тогда
		РежимВыбора = Параметры.РежимВыбора;
	КонецЕсли;
	ВыборМатериалов = РежимВыбора = "Контекст";
	ПояснениеВыбора = НСтр(
		"ru = 'Выберите беседу, затем отметьте нужные сообщения или файлы.
			|Нажмите «Добавить выбранное». Цитату можно указать для одного сообщения.'");
	Элементы.ПояснениеВыбора.Видимость = ВыборМатериалов;
	Элементы.Материалы.Видимость = ВыборМатериалов;
	Элементы.ОтметитьСообщения.Видимость = ВыборМатериалов;
	Элементы.СнятьВыбор.Видимость = ВыборМатериалов;
	Если ВыборМатериалов Тогда
		Заголовок = НСтр("ru = 'Добавить материалы из своей беседы'");
		Элементы.Выбрать.Заголовок = НСтр("ru = 'Добавить выбранное'");
	КонецЕсли;
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДиалогиПриАктивизацииСтроки(Элемент)
	ОтключитьОбработчикОжидания("ЗагрузитьМатериалыВыбора");
	Если РежимВыбора <> "Контекст" Тогда
		Возврат;
	КонецЕсли;
	Сообщения.Очистить();
	Файлы.Очистить();
	Цитата = "";
	ПодключитьОбработчикОжидания("ЗагрузитьМатериалыВыбора", 0.2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМатериалыВыбора() Экспорт
	ТекущаяБеседа = Элементы.СписокДиалогов.ТекущиеДанные;
	Если ТекущаяБеседа = Неопределено Или РежимВыбора <> "Контекст" Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьМатериалыНаСервере(ТекущаяБеседа.Диалог);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииВыбора()
	ОтключитьОбработчикОжидания("ЗагрузитьМатериалыВыбора");
КонецПроцедуры

&НаКлиенте
Процедура СообщенияПриАктивизацииСтроки(Элемент)
	ТекущееСообщение = Элементы.СписокСообщений.ТекущиеДанные;
	Если ТекущееСообщение <> Неопределено Тогда
		Цитата = ТекущееСообщение.Текст;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	ТекущаяБеседа = Элементы.СписокДиалогов.ТекущиеДанные;
	Если ТекущаяБеседа = Неопределено Тогда
		ТекстПредупреждения = НСтр("ru = 'Выберите свою беседу из списка.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	Если РежимВыбора = "Открытие" Тогда
		Закрыть(ТекущаяБеседа.Диалог);
		Возврат;
	КонецЕсли;
	Источники = ВыбранныеИсточникиБеседы(ТекущаяБеседа.Диалог);
	Если Источники.Количество() = 0 Тогда
		ТекстПредупреждения = НСтр(
			"ru = 'Отметьте нужные сообщения или файлы. Для всей беседы выберите «Все сообщения».'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	Закрыть(Источники);
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьСообщения(Команда)
	Если Элементы.СтраницыМатериалов.ТекущаяСтраница = Элементы.СтраницаФайлы Тогда
		Для Каждого Файл Из Файлы Цикл
			Файл.Выбор = Истина;
		КонецЦикла;
	Иначе
		Для Каждого Сообщение Из Сообщения Цикл
			Сообщение.Выбор = Истина;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыбор(Команда)
	Для Каждого Сообщение Из Сообщения Цикл
		Сообщение.Выбор = Ложь;
	КонецЦикла;
	Для Каждого Файл Из Файлы Цикл
		Файл.Выбор = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()
	Диалоги.Очистить();
	ДоступныеБеседы = КИИ_ХранениеДиалогов.МоиДиалоги();
	Для Каждого Беседа Из ДоступныеБеседы Цикл
		СтрокаБеседы = Диалоги.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаБеседы, Беседа);
	КонецЦикла;
	Сообщения.Очистить();
	Файлы.Очистить();
	Цитата = "";
КонецПроцедуры

&НаСервере
Процедура ПрочитатьМатериалыНаСервере(Знач Диалог)
	Сообщения.Очистить();
	Файлы.Очистить();
	Цитата = "";
	ДоступныеСообщения = КИИ_ХранениеДиалогов.СообщенияДиалога(Диалог, 0, 0);
	Для Каждого Сообщение Из ДоступныеСообщения Цикл
		СтрокаСообщения = Сообщения.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСообщения, Сообщение);
	КонецЦикла;
	ДоступныеМатериалы = КИИ_ХранениеДиалогов.МатериалыДиалога(Диалог);
	Для Каждого Материал Из ДоступныеМатериалы Цикл
		Если Материал.Вид <> "Контекст" Тогда
			СтрокаФайла = Файлы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаФайла, Материал);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ВыбранныеИсточникиБеседы(Знач ИдентификаторБеседы)
	Источники = Новый Массив;
	ЧислоСообщений = 0;
	Для Каждого Сообщение Из Сообщения Цикл
		Если Сообщение.Выбор Тогда
			ЧислоСообщений = ЧислоСообщений + 1;
		КонецЕсли;
	КонецЦикла;
	ТекущееСообщение = Элементы.СписокСообщений.ТекущиеДанные;
	Для Каждого Сообщение Из Сообщения Цикл
		Если Не Сообщение.Выбор Тогда
			Продолжить;
		КонецЕсли;
		Источник = Новый Структура("Диалог,Сообщение", ИдентификаторБеседы, Сообщение.Сообщение);
		МожноПрименитьЦитату = ЧислоСообщений = 1 И ТекущееСообщение <> Неопределено;
		Если МожноПрименитьЦитату Тогда
			МожноПрименитьЦитату = ТекущееСообщение.Сообщение = Сообщение.Сообщение И Цитата <> Сообщение.Текст;
		КонецЕсли;
		Если МожноПрименитьЦитату Тогда
			Источник.Вставить("Фрагмент", Цитата);
		КонецЕсли;
		Источники.Добавить(Источник);
	КонецЦикла;
	Для Каждого Файл Из Файлы Цикл
		Если Файл.Выбор Тогда
			Источник = Новый Структура("Диалог,Материал", ИдентификаторБеседы, Файл.Материал);
			Источники.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Источники;
КонецФункции

#КонецОбласти
